# Copy to .env for local development. Do not commit .env.
# The public demo uses demo.env.example with docker-compose.prod.yml.

# PostgreSQL
DATABASE_CONNECTION=Host=localhost;Port=5432;Database=claimlens;Username=claimlens;Password=claimlens

# JWT signing key. Use a long random value in any shared environment.
JWT_SECRET=replace-with-a-long-random-string
JWT_ISSUER=claimlens
JWT_AUDIENCE=claimlens-web
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Browser origin allowed by CORS
WEB_ORIGIN=http://localhost:5173

# Leave empty during `npm run dev` so Vite proxies /api to the API.
# Set this when building the web image. docker-compose passes it as a build arg.
VITE_API_URL=

# Internal URL of the FastAPI service, used by the .NET API only
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=replace-with-a-shared-internal-key

# Leave empty to use the mock LLM and mock evidence provider
AI_PROVIDER_KEY=
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_MODEL=gpt-4o-mini

# Not used in MVP
REDIS_CONNECTION=
